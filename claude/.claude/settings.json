{
	"includeCoAuthoredBy": false,
	"permissions": {
		"allow": [
			"Read(*)",
			"Bash(ls:*)",
			"Bash(cat:*)",
			"Bash(head:*)",
			"Bash(tail:*)",
			"Bash(wc:*)",
			"Bash(find:*)",
			"Bash(grep:*)",
			"Bash(rg:*)",
			"Bash(git log:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git show:*)",
			"Bash(git branch:*)",
			"Bash(git remote:*)",
			"Bash(git stash:*)",
			"Bash(git add:*)"
		],
		"deny": [
			"Read(**/.env*)",
			"Read(**/env.php*)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Read(**/secrets/**)",
			"Read(**/credentials/**)",
			"Read(**/.aws/**)",
			"Read(**/.ssh/**)",
			"Read(**/config/database.yml)",
			"Bash(rm -rf:*)"
		],
		"ask": [
			"Bash(git commit:*)",
			"Bash(git push:*)"
		],
		"defaultMode": "auto",
		"disableBypassPermissionsMode": "disable"
	},
	"hooks": {},
	"statusLine": {
		"type": "command",
		"command": "bash ~/.claude/statusline-command.sh"
	},
	"enabledPlugins": {
		"typescript-lsp@claude-plugins-official": true,
		"swift-lsp@claude-plugins-official": true
	},
	"language": "Español",
	"spinnerVerbs": {
		"mode": "append",
		"verbs": [
			"Chemitaxing",
			"Moisesing",
			"Noelinging",
			"Manolitonging",
			"Ponferrading"
		]
	},
	"alwaysThinkingEnabled": true,
	"theme": "dark",
	"editorMode": "vim"
}
